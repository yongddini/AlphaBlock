# AlphaBlock DB 무결성 전수 점검 oneshot (WAN-185, doctor = WAN-194, 주기·우선순위 = WAN-318).
#
# scripts/install-systemd.sh 가 __PLACEHOLDER__ 를 치환해
# /etc/systemd/system/alphablock-doctor.service 로 설치한다. 이 유닛은 부팅 시
# 자동 시작하지 않는다 — 짝인 alphablock-doctor.timer 가 주기적으로 트리거한다.
#
# doctor 는 손상·복구 산출물·빈 장부·처분 미기록 체결이 하나라도 있으면 종료 코드 1을
# 낸다 → systemd 가 이 유닛을 "failed" 로 기록한다(`systemctl --failed` 로 감시 가능).
# --notify-on-failure 로 이상 시 텔레그램 경고도 보낸다(ALPHABLOCK_TELEGRAM_* 설정 시).
# ⚠️ 그래서 이 유닛에는 SuccessExitStatus 를 넣지 않는다 — 넣으면 실패 감시가 죽는다
# (collector·live·dashboard 의 SuccessExitStatus=143 은 정상 정지용이고 성격이 다르다).
#
# 이 유닛이 「전수」 판이다 — `PRAGMA quick_check` 가 DB 전 페이지를 읽는다(서버 실측
# 2026-08-17: 4.0GB DB 에 18분+, 실효 3.7MB/s). 그래서 하루 1회로 돌리고, 싼 점검만
# 자주 보는 판은 alphablock-doctor-light.service 가 따로 맡는다(WAN-318 §2).

[Unit]
Description=AlphaBlock DB integrity check, full incl. PRAGMA quick_check (doctor, WAN-194)
After=network-online.target

[Service]
Type=oneshot
User=__RUN_USER__
WorkingDirectory=__WORKDIR__
Environment=PATH=__PATH__
ExecStart=__UV_BIN__ run -- alphablock doctor --notify-on-failure

# WAN-318 §1: 수집기·러너와 디스크를 두고 싸우지 않게 한 단계 물러선다. 무결성 점검은
# 몇 분 늦게 끝나도 되지만, 봉 수집과 러너 평가는 늦으면 그 자체가 사고다.
Nice=19
IOSchedulingClass=idle

# 수집기·러너·대시보드와 같은 파일 로그 규약.
StandardOutput=append:__LOG_DIR__/doctor.log
StandardError=append:__LOG_DIR__/doctor.log
