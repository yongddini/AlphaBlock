# Secrets / env
.env

# 개인키 — 원격이 공개 저장소라 `git add -A` 한 번에 유출된다.
# 저장소 루트 ssh/ 에 실제 키가 있었다(추적된 적은 없음). 확장자 글롭도 함께 건다.
ssh/
*.key
*.ppk
*.pem

# Virtual environments
.venv/

# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Data artifacts
data/*.db
# WAL 저널 부산물 (WAN-156 §4) — `data/*.db` 글롭이 잡지 못한다
data/*.db-wal
data/*.db-shm
data/*.parquet
data/*.json
# 손상 조사 증거물 (WAN-194/195) — `data/*.db` 글롭이 `.db`로 끝나는 것만 잡아
# `ohlcv.db.corrupt.bak`·`.old`(각 1.4GB)가 untracked로 남는다. 실수로 `git add -A`
# 하면 GB 단위 커밋이 되고, WAN-194가 "덮어쓰지 말 것"이라 못 박은 원본 증거다.
data/*.db.*
# FUSE가 「열려 있는데 삭제된」 파일에 붙이는 이름. 여기 있는 것들은 SQLite `-shm`
# 이고 손상 시점의 마운트 상태를 증언한다(WAN-195 §1) — 커밋 대상은 아니다.
data/.fuse_hidden*

# 1분봉 등 전체 로드 parquet 캐시 (WAN-78) — data/*.parquet는 하위 디렉터리를 잡지 못함
data/cache/

# 북 후보 payload 캐시 (WAN-394 §0) — 재계산 가능한 산출물이고 GB 단위로 큰다.
# 정리는 `uv run python -m backtest.payload_cache --prune-stale --apply`(명시 플래그).
backtest/cache/

# Report / analysis outputs (backtest·parity·walkforward)
out/

# 상시 구동 데몬 로그 (WAN-31)
logs/

# Local-only Claude Code settings (shared: .claude/settings.json)
.claude/settings.local.json
.claude/worktrees/

# Tool caches
.mypy_cache/
.ruff_cache/
.pytest_cache/

# macOS
.DS_Store
.auto-dev.log
